<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>__MODULE__ — Dependency Graph</title>
<style>
  html, body { margin: 0; padding: 0; height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  header { padding: 12px 20px; background: #f8f9fa; border-bottom: 1px solid #dee2e6; }
  header h1 { margin: 0 0 4px; font-size: 18px; }
  header p { margin: 0 0 6px; color: #6c757d; font-size: 13px; }
  header a { color: #0d6efd; text-decoration: none; }
  header a:hover { text-decoration: underline; }
  #legend { font-size: 12px; color: #495057; }
  #legend .chip { display: inline-block; padding: 2px 10px; border-radius: 12px;
    margin-right: 6px; border: 2px solid; }
  #cy { width: 100vw; height: calc(100vh - 110px); }
</style>
</head>
<body>
<header>
  <h1>__MODULE__ — Dependency Graph</h1>
  <p>Generated from <a href="DEPENDENCIES.md">DEPENDENCIES.md</a> by
     <code>tools/render-dependencies.py</code>. Drag to pan, scroll to zoom,
     click a node to highlight its neighbors, click empty space to reset.</p>
  <div id="legend">
    <span class="chip" style="background:#cfe2ff;border-color:#0d6efd">program</span>
    <span class="chip" style="background:#bcd6fb;border-color:#0d6efd;border-style:dashed">nested program</span>
    <span class="chip" style="background:#d1e7dd;border-color:#198754">copybook</span>
    <span class="chip" style="background:#fff3cd;border-color:#fd7e14">input file</span>
    <span class="chip" style="background:#fcd5b5;border-color:#fd7e14">output file</span>
    <span class="chip" style="background:#e2d6f5;border-color:#6f42c1">SQL table</span>
    <span class="chip" style="background:#e9ecef;border-color:#6c757d">C shim</span>
  </div>
</header>
<div id="cy"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dagre@0.8.5/dist/dagre.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape-dagre@2.5.0/cytoscape-dagre.min.js"></script>
<script>
cytoscape.use(cytoscapeDagre);
const data = __GRAPH_JSON__;
const elements = [
  ...data.nodes.map(n => ({ data: { id: n.id, label: n.label }, classes: 'type-' + n.type })),
  ...data.edges.map(e => ({ data: { source: e.src, target: e.dst, label: e.label }}))
];
const cy = cytoscape({
  container: document.getElementById('cy'),
  elements: elements,
  layout: { name: 'dagre', rankDir: 'LR',
            nodeSep: 30, edgeSep: 10, rankSep: 90,
            fit: true, padding: 30, animate: false },
  style: [
    { selector: 'node', style: {
        'label': 'data(label)', 'text-valign': 'center', 'text-halign': 'center',
        'text-wrap': 'wrap', 'text-max-width': 100, 'font-size': 10,
        'padding': '5px', 'shape': 'round-rectangle',
        'width': 'label', 'height': 'label', 'border-width': 1.5
    }},
    { selector: 'node.type-program',         style: { 'background-color': '#cfe2ff', 'border-color': '#0d6efd' }},
    { selector: 'node.type-program-nested',  style: { 'background-color': '#bcd6fb', 'border-color': '#0d6efd', 'border-style': 'dashed' }},
    { selector: 'node.type-copybook',        style: { 'background-color': '#d1e7dd', 'border-color': '#198754' }},
    { selector: 'node.type-file-in',         style: { 'background-color': '#fff3cd', 'border-color': '#fd7e14' }},
    { selector: 'node.type-file-out',        style: { 'background-color': '#fcd5b5', 'border-color': '#fd7e14' }},
    { selector: 'node.type-sql-table',       style: { 'background-color': '#e2d6f5', 'border-color': '#6f42c1' }},
    { selector: 'node.type-shim',            style: { 'background-color': '#e9ecef', 'border-color': '#6c757d', 'color': '#495057' }},
    { selector: 'edge', style: {
        'label': 'data(label)', 'font-size': 10, 'color': '#495057',
        'text-background-color': '#fff', 'text-background-opacity': 0.85,
        'text-background-padding': '2px', 'text-rotation': 'autorotate',
        'curve-style': 'bezier', 'target-arrow-shape': 'triangle',
        'line-color': '#adb5bd', 'target-arrow-color': '#adb5bd', 'width': 1.5
    }},
    { selector: '.faded', style: { 'opacity': 0.2 }},
    { selector: '.highlight', style: {
        'line-color': '#0d6efd', 'target-arrow-color': '#0d6efd', 'width': 3 }}
  ]
});
cy.on('tap', 'node', evt => {
  const node = evt.target;
  cy.elements().addClass('faded');
  node.removeClass('faded');
  node.connectedEdges().removeClass('faded').addClass('highlight');
  node.neighborhood('node').removeClass('faded');
});
cy.on('tap', evt => { if (evt.target === cy) cy.elements().removeClass('faded highlight'); });
</script>
</body>
</html>
