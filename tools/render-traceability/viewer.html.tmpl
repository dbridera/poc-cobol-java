<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__MODULE__ — COBOL ↔ Java traceability</title>
<style>
  :root { color-scheme: light dark;
    --bg:#fafaf8; --fg:#1b1b1f; --muted:#6b6b70; --line:#e2e2e0; --pane:#ffffff;
    --hl:#fff1b8; --hl2:#ffd27a; --ok:#1f7a3a; --okbg:#dff5e5; --warn:#8a5a00; --warnbg:#fff0cc; --bad:#9b1c1c; --badbg:#fde2e2;
    --para:#edf2ff; --link:#0b57d0; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  @media (prefers-color-scheme: dark) { :root { color-scheme: dark;
    --bg:#121214; --fg:#e8e8ea; --muted:#9a9aa2; --line:#2c2c32; --pane:#1a1a1e;
    --hl:#4a3f10; --hl2:#6b5a16; --ok:#8fd3a3; --okbg:#143a22; --warn:#f0c674; --warnbg:#3d2f08; --bad:#f28b8b; --badbg:#461414;
    --para:#1d2740; --link:#8ab4ff; } }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg); font:14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  header { padding:14px 20px; border-bottom:1px solid var(--line); display:flex; flex-wrap:wrap; gap:14px; align-items:baseline; }
  header h1 { font-size:17px; margin:0; }
  header .stats { color:var(--muted); font-size:13px; }
  header input { margin-left:auto; padding:6px 10px; border:1px solid var(--line); border-radius:6px; background:var(--pane); color:var(--fg); min-width:240px; }
  .legend span { display:inline-block; padding:1px 8px; border-radius:10px; font-size:12px; margin-right:6px; }
  .b-ok { background:var(--okbg); color:var(--ok); } .b-warn { background:var(--warnbg); color:var(--warn); } .b-bad { background:var(--badbg); color:var(--bad); }
  main { display:grid; grid-template-columns:1fr 1fr; gap:0; height:calc(100vh - 62px); }
  @media (max-width: 900px) { main { grid-template-columns:1fr; height:auto; } .pane { height:60vh; } }
  .pane { display:flex; flex-direction:column; border-right:1px solid var(--line); min-width:0; }
  .tabs { display:flex; flex-wrap:wrap; gap:4px; padding:8px 10px; border-bottom:1px solid var(--line); background:var(--pane); }
  .tabs button { border:1px solid var(--line); background:transparent; color:var(--fg); border-radius:6px; padding:3px 8px; font-size:12px; cursor:pointer; font-family:var(--mono); }
  .tabs button.active { background:var(--para); border-color:var(--link); }
  .code { overflow:auto; flex:1; font-family:var(--mono); font-size:12.5px; line-height:1.5; background:var(--pane); }
  .ln { display:flex; white-space:pre; }
  .ln .n { width:56px; flex:none; text-align:right; padding-right:10px; color:var(--muted); user-select:none; }
  .ln .t { flex:1; min-width:0; }
  .ln.hl { background:var(--hl); } .ln.hl2 { background:var(--hl2); }
  .ln.para { background:var(--para); font-weight:600; cursor:pointer; }
  .ln.para .badge { margin-left:12px; font-weight:500; font-size:11px; padding:0 7px; border-radius:9px; }
  .ln.para .cites { margin-left:10px; font-weight:400; color:var(--muted); font-size:11px; }
  .ln .cite { color:var(--link); text-decoration:underline; cursor:pointer; }
  .ln.match { outline:2px solid var(--link); outline-offset:-2px; }
  .info { padding:6px 12px; border-top:1px solid var(--line); font-size:12px; color:var(--muted); min-height:30px; background:var(--pane); }
  .info a { color:var(--link); cursor:pointer; }
</style>
</head>
<body>
<header>
  <h1>__MODULE__ — COBOL ↔ Java traceability</h1>
  <div class="stats" id="stats"></div>
  <div class="legend"><span class="b-ok">covered / cited</span><span class="b-warn">not cited by Java</span><span class="b-bad">never executed</span></div>
  <input id="search" type="search" placeholder="search both panes (Enter = next)">
</header>
<main>
  <section class="pane" id="cobolPane"><div class="tabs" id="cobolTabs"></div><div class="code" id="cobolCode"></div><div class="info" id="cobolInfo">Click a paragraph to see which Java locations cite it.</div></section>
  <section class="pane" id="javaPane"><div class="tabs" id="javaTabs"></div><div class="code" id="javaCode"></div><div class="info" id="javaInfo">Click a <u>COBOL: file:lines</u> citation to jump to the COBOL.</div></section>
</main>
<script id="data" type="application/json">__DATA_JSON__</script>
<script>
(function () {
  const data = JSON.parse(document.getElementById('data').textContent);
  const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const nFix = data.stats.fixtures.length;
  const $ = id => document.getElementById(id);

  $('stats').textContent = `${data.stats.cobol_files} COBOL files · ${data.stats.paragraphs} paragraphs · ${data.stats.cited} cited by Java · `
    + (nFix ? `${data.stats.covered} executed by the ${nFix} fixtures · ` : '') + `${data.stats.java_files} Java files · ${data.stats.links} citations`;

  let cobolIdx = 0, javaIdx = 0;
  const cobolByPath = Object.fromEntries(data.cobol.map((f, i) => [f.path, i]));

  function tabs(container, files, active, onPick) {
    container.innerHTML = '';
    files.forEach((f, i) => {
      const b = document.createElement('button');
      b.textContent = f.path.split('/').pop();
      b.title = f.path;
      if (i === active) b.classList.add('active');
      b.onclick = () => onPick(i);
      container.appendChild(b);
    });
  }

  function badge(p) {
    if (nFix && p.covered === 0) return `<span class="badge b-bad">0/${nFix} fixtures</span>`;
    const parts = [];
    if (nFix) parts.push(`<span class="badge b-ok">${p.covered}/${nFix} fixtures</span>`);
    parts.push(p.cited_by.length ? `<span class="badge b-ok">${p.cited_by.length} Java citation${p.cited_by.length > 1 ? 's' : ''}</span>`
                                 : `<span class="badge b-warn">not cited by Java</span>`);
    return parts.join('');
  }

  function renderCobol(i) {
    cobolIdx = i;
    const f = data.cobol[i];
    tabs($('cobolTabs'), data.cobol, i, renderCobol);
    const paraAt = {};
    f.paragraphs.forEach(p => paraAt[p.start] = p);
    const html = f.lines.map((t, k) => {
      const n = k + 1, p = paraAt[n];
      if (p) return `<div class="ln para" id="c-${i}-${n}" data-para="${p.name}"><span class="n">${n}</span><span class="t">${esc(t)}${badge(p)}</span></div>`;
      return `<div class="ln" id="c-${i}-${n}"><span class="n">${n}</span><span class="t">${esc(t)}</span></div>`;
    }).join('');
    $('cobolCode').innerHTML = html;
    $('cobolCode').querySelectorAll('.ln.para').forEach(el => el.onclick = () => showCites(f, el.dataset.para));
  }

  function showCites(f, name) {
    const p = f.paragraphs.find(x => x.name === name);
    if (!p) return;
    const list = p.cited_by.map(c => `<a data-java="${c.java}" data-line="${c.line}">${c.java.split('/').pop()}:${c.line}</a>`).join(' · ');
    $('cobolInfo').innerHTML = `<b>${p.program} ${p.name}</b> (lines ${p.start}-${p.end})` + (nFix ? ` · executed by ${p.covered}/${nFix} fixtures` : '')
      + ` · cited by: ${list || '<span class="b-warn">nothing in the Java</span>'}`;
    $('cobolInfo').querySelectorAll('a').forEach(a => a.onclick = () => jumpJava(a.dataset.java, +a.dataset.line));
    highlight('cobolCode', `c-${cobolIdx}-`, p.start, p.end, 'hl');
  }

  function renderJava(i) {
    javaIdx = i;
    const f = data.java[i];
    tabs($('javaTabs'), data.java, i, renderJava);
    const linksAt = {};
    f.links.forEach(l => (linksAt[l.line] = linksAt[l.line] || []).push(l));
    const html = f.lines.map((t, k) => {
      const n = k + 1;
      let text = esc(t);
      if (linksAt[n]) {
        text = text.replace(/COBOL:[^\n]*?\.(?:cbl|cpy|CBL|COB|CPY)\s*:\s*\d+(?:\s*-\s*\d+)?/g, m => `<span class="cite" data-line="${n}">${m}</span>`);
      }
      return `<div class="ln" id="j-${i}-${n}"><span class="n">${n}</span><span class="t">${text}</span></div>`;
    }).join('');
    $('javaCode').innerHTML = html;
    $('javaCode').querySelectorAll('.cite').forEach(el => el.onclick = () => {
      const ls = linksAt[+el.dataset.line].filter(l => l.resolved);
      if (!ls.length) { $('javaInfo').textContent = 'Citation does not resolve to a file of this module.'; return; }
      const l = ls[0];
      $('javaInfo').innerHTML = `→ <b>${l.cobol}</b> lines ${ls.map(x => x.start + '-' + x.end).join(', ')}`;
      jumpCobol(l.cobol, ls);
    });
  }

  function highlight(codeId, prefix, start, end, cls) {
    const code = $(codeId);
    code.querySelectorAll('.ln.hl, .ln.hl2').forEach(el => el.classList.remove('hl', 'hl2'));
    for (let n = start; n <= end; n++) { const el = document.getElementById(prefix + n); if (el) el.classList.add(cls); }
    const first = document.getElementById(prefix + start);
    if (first) first.scrollIntoView({ block: 'center' });
  }

  function jumpCobol(path, ranges) {
    const i = cobolByPath[path];
    if (i === undefined) return;
    if (i !== cobolIdx) renderCobol(i);
    const code = $('cobolCode');
    code.querySelectorAll('.ln.hl, .ln.hl2').forEach(el => el.classList.remove('hl', 'hl2'));
    ranges.forEach((r, k) => { for (let n = r.start; n <= r.end; n++) { const el = document.getElementById(`c-${i}-${n}`); if (el) el.classList.add(k ? 'hl2' : 'hl'); } });
    const first = document.getElementById(`c-${i}-${ranges[0].start}`);
    if (first) first.scrollIntoView({ block: 'center' });
  }

  function jumpJava(path, line) {
    const i = data.java.findIndex(f => f.path === path);
    if (i < 0) return;
    if (i !== javaIdx) renderJava(i);
    highlight('javaCode', `j-${i}-`, line, line, 'hl');
  }

  // search over both panes: Enter cycles through matches
  let matches = [], mi = -1;
  $('search').addEventListener('keydown', e => {
    if (e.key !== 'Enter') return;
    const q = e.target.value.trim().toLowerCase();
    if (!q) return;
    if (!matches.length || matches.q !== q) {
      matches = [];
      matches.q = q;
      data.cobol.forEach((f, i) => f.lines.forEach((t, k) => { if (t.toLowerCase().includes(q)) matches.push({ side: 'c', i, n: k + 1 }); }));
      data.java.forEach((f, i) => f.lines.forEach((t, k) => { if (t.toLowerCase().includes(q)) matches.push({ side: 'j', i, n: k + 1 }); }));
      mi = -1;
    }
    if (!matches.length) { $('cobolInfo').textContent = `no match for "${q}"`; return; }
    mi = (mi + 1) % matches.length;
    const m = matches[mi];
    if (m.side === 'c') { if (m.i !== cobolIdx) renderCobol(m.i); highlight('cobolCode', `c-${m.i}-`, m.n, m.n, 'hl'); }
    else { if (m.i !== javaIdx) renderJava(m.i); highlight('javaCode', `j-${m.i}-`, m.n, m.n, 'hl'); }
    $('cobolInfo').textContent = `match ${mi + 1} / ${matches.length} for "${q}"`;
  });

  renderCobol(0);
  renderJava(0);
})();
</script>
</body>
</html>
